# Copy this file to API/.env and fill in only the services you use.
# Do not commit real keys.

# Optional OpenAI-compatible image / chat / video endpoint
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional ModelScope token
# MODELSCOPE_API_KEY=

# Optional ComfyUI
# COMFYUI_BASE_URL=http://127.0.0.1:8188
